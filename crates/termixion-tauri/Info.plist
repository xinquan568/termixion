<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- trmx-224: merged over the generated bundle Info.plist by tauri-bundler (an Info.plist
     next to tauri.conf.json is picked up by tauri-cli). Declares the Finder Services entry;
     the handler is TermixionServicesProvider in termixion-platform (NSMessage `openTab` →
     `openTab:userData:error:`), registered during setup(). Shape mirrors kitty/iTerm2. -->
<plist version="1.0">
<dict>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>New Termixion Tab Here</string>
			</dict>
			<key>NSMessage</key>
			<string>openTab</string>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSTextContent</key>
				<string>FilePath</string>
			</dict>
			<key>NSSendTypes</key>
			<array>
				<string>NSFilenamesPboardType</string>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
