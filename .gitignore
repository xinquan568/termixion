/reports/
__pycache__/

# macOS
.DS_Store

# Secrets / signing (never commit — P0-2, trmx-48 updater key)
*.p12
*.p8
*.cer
*.mobileprovision
*.pem
*.key

# Editor
.idea
.vscode
*.swp

# Tauri generated schemas (regenerated by tauri-build on every build)
/crates/termixion-tauri/gen/schemas/

# trmx-207: fetched Starship sidecar binaries (scripts/fetch-starship.sh) — never committed.
crates/termixion-tauri/binaries/

# trmx-240: zsh wordcode is never committed — zsh loads a .zwc in preference to the .zsh beside it,
# so a committed blob, not the reviewable source, is what would execute. powerlevel10k compiles its
# own on first load. This matters in the working tree because the real-PTY tests point p10k at
# `resources/shell-enhancements` DIRECTLY (crates/termixion-platform/tests/common/mod.rs), so running
# them leaves 8 freshly-compiled .zwc files here; without this, a `git add -A` would re-commit them.
# `scripts/check-no-zwc.sh` is the backstop in CI.
*.zwc

# trmx-251: CI-only, collected from $HOME before the failure-path artifact upload
/smoke-logs
